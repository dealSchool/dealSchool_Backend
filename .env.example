# Copy this file to .env.local and fill in your values
# .env.local is gitignored — never commit it

# ── Cashfree ──────────────────────────────────────────────────────────────────
# Which credential pair is actually used (sandbox vs live) is controlled at
# runtime via the "settings/payment" Firestore doc — switch it with
# GET/PATCH /settings/payment (admin-only). Both pairs must be set here so the
# app can switch without a redeploy; whichever one isn't currently selected is
# simply unused. Defaults to sandbox if the Firestore doc doesn't exist yet.
CASHFREE_APP_ID_SANDBOX=TEST10xxxxxxxxxxxxxxxxxxxxxxxxxxx
CASHFREE_SECRET_KEY_SANDBOX=cfsk_ma_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CASHFREE_APP_ID_LIVE=your_live_app_id
CASHFREE_SECRET_KEY_LIVE=cfsk_ma_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fellowship fee in rupees — 1000 = ₹1000 payment link
FELLOWSHIP_FEE=1000

# ── App URL (Cashfree redirects here after payment) ───────────────────────────
APP_BASE_URL=http://localhost:3000

# ── Email (Nodemailer / Google Workspace SMTP) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_app_password
ADMIN_EMAIL=admin@yourdomain.com

# ── CORS — comma-separated list of allowed frontend origins ───────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Firebase Web API Key (for admin login via REST) ───────────────────────────
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── WhatsApp reminders (Cheerio) — all /cron/* nudge jobs share these ─────────
CHEERIO_API_KEY=your_cheerio_api_key
CHEERIO_API_URL=https://newprod.api.cheerio.in/direct-apis/v1/whatsapp/template/send

# Static "Schedule Interview" CTA link sent by the interview-shortlisted-followup
# cron — same link for every applicant, not per-applicant.
INTERVIEW_SCHEDULE_URL=https://dealschool.in/schedule-interview

# ── Cron job auth — shared secret checked against the Authorization header on
# every GET /cron/* route (incomplete-applicants, brochure-reminders,
# application-followup, application-audit-followup,
# interview-shortlisted-followup, payment-reminder). Append ?force=true to any
# of these locally to bypass the time threshold for testing — dedup flags
# still apply, so it never double-sends. Never append force=true from the
# real crontab. ────────────────────────────────────────────────────────────
CRON_SECRET=generate_a_long_random_string

# ── Internal cron scheduler (src/lib/cron-scheduler.ts) ───────────────────────
# All 6 reminder jobs above now also run automatically from inside the app
# itself (hourly) — this only ever activates under `next start` (production);
# `next dev` never runs it, so local dev is always safe even when pointed at
# the production Firebase project. Set to "true" on the VPS to pause all
# automatic sends without a redeploy (e.g. during an incident) — leave unset
# otherwise.
DISABLE_CRON_SCHEDULER=false
